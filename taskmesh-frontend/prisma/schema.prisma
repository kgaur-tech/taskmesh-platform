generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PARTICIPANT
  LEADER
  ADMIN
}

enum InitiativeStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum Cadence {
  DAILY
  WEEKLY
  CUSTOM
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  DRAFT
  UPLOADING
  SUBMITTED
  PROCESSING
  EVALUATING
  EVALUATED
  FAILED
  RESUBMISSION_REQUIRED
}

enum EvaluationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum SubmissionType {
  TEXT
  CODE
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  LINK
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REMINDER
  DEADLINE_APPROACHING
  SUBMISSION_RECEIVED
  EVALUATION_COMPLETED
  FEEDBACK_AVAILABLE
  INITIATIVE_UPDATE
  GROUP_UPDATE
  LEADER_ANNOUNCEMENT
  SYSTEM
}

model User {
  id               String                 @id @default(cuid())
  googleId         String?                @unique
  email            String                 @unique
  name             String?
  username         String?                @unique
  avatarUrl        String?
  role             Role                   @default(PARTICIPANT)
  timezone         String                 @default("UTC")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  ownedInitiatives Initiative[]           @relation("InitiativeOwner")
  memberships      InitiativeMembership[]
  submissions      Submission[]
  groupsOwned      Group[]                @relation("GroupOwner")
  groupMemberships GroupMembership[]
  notifications    Notification[]
  progress         Progress[]
  streaks          Streak[]
  auditEvents      AuditEvent[]
}

model Initiative {
  id               String                 @id @default(cuid())
  slug             String                 @unique
  title            String
  description      String
  objective        String
  category         String
  status           InitiativeStatus       @default(DRAFT)
  visibility       Visibility             @default(PUBLIC)
  joinCode         String?                @unique
  timezone         String                 @default("UTC")
  cadence          Cadence                @default(DAILY)
  customSchedule   Json?
  startDate        DateTime?
  endDate          DateTime?
  participantLimit Int?
  rules            String[]
  ownerId          String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  owner            User                   @relation("InitiativeOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships      InitiativeMembership[]
  tasks            Task[]
  rubric           Rubric?
  groups           Group[]
  progress         Progress[]
  streaks          Streak[]
  reports          Report[]

  @@index([ownerId, status])
  @@index([status, visibility])
}

model InitiativeMembership {
  id           String           @id @default(cuid())
  userId       String
  initiativeId String
  status       MembershipStatus @default(ACTIVE)
  joinedAt     DateTime         @default(now())
  leftAt       DateTime?
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  initiative   Initiative       @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@unique([userId, initiativeId])
  @@index([initiativeId, status])
  @@index([userId, status])
}

model Task {
  id              String           @id @default(cuid())
  initiativeId    String
  title           String
  description     String
  instructions    String?
  taskType        String
  scheduledFor    DateTime?
  dueAt           DateTime?
  cadence         Cadence?
  submissionTypes SubmissionType[]
  points          Int              @default(1)
  weight          Float            @default(1)
  status          TaskStatus       @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  initiative      Initiative       @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  submissions     Submission[]

  @@index([initiativeId, status, dueAt])
}

model Submission {
  id          String            @id @default(cuid())
  taskId      String
  userId      String
  version     Int               @default(1)
  status      SubmissionStatus  @default(DRAFT)
  content     String?
  url         String?
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       SubmissionMedia[]
  evaluations Evaluation[]

  @@unique([taskId, userId, version])
  @@index([userId, status, createdAt])
  @@index([taskId, status])
}

model SubmissionMedia {
  id           String     @id @default(cuid())
  submissionId String
  publicId     String
  secureUrl    String
  resourceType String
  format       String?
  bytes        Int?
  duration     Float?
  width        Int?
  height       Int?
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Rubric {
  id           String            @id @default(cuid())
  initiativeId String            @unique
  version      Int               @default(1)
  name         String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  initiative   Initiative        @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  criteria     RubricCriterion[]
  evaluations  Evaluation[]
}

model RubricCriterion {
  id           String           @id @default(cuid())
  rubricId     String
  name         String
  description  String
  weight       Float            @default(1)
  maxScore     Int              @default(100)
  instructions String?
  enabled      Boolean          @default(true)
  rubric       Rubric           @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores       CriterionScore[]

  @@index([rubricId, enabled])
}

model Evaluation {
  id              String           @id @default(cuid())
  evaluationKey   String           @unique
  submissionId    String
  rubricId        String?
  status          EvaluationStatus @default(QUEUED)
  provider        String?
  providerRunId   String?
  overallScore    Float?
  summary         String?
  strengths       String[]
  weaknesses      String[]
  recommendations String[]
  confidence      Float?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime         @default(now())
  completedAt     DateTime?
  submission      Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rubric          Rubric?          @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  criterionScores CriterionScore[]
  feedback        Feedback?

  @@index([submissionId, status])
}

model CriterionScore {
  id           String          @id @default(cuid())
  evaluationId String
  criterionId  String
  score        Float
  rationale    String?
  evaluation   Evaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion    RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
}

model Feedback {
  id           String     @id @default(cuid())
  evaluationId String     @unique
  nextSteps    String[]
  createdAt    DateTime   @default(now())
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
}

model Progress {
  id             String     @id @default(cuid())
  userId         String
  initiativeId   String
  completedTasks Int        @default(0)
  expectedTasks  Int        @default(0)
  averageScore   Float?
  points         Int        @default(0)
  completionRate Float      @default(0)
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  initiative     Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@unique([userId, initiativeId])
  @@index([initiativeId, points])
}

model Streak {
  id              String     @id @default(cuid())
  userId          String
  initiativeId    String
  current         Int        @default(0)
  longest         Int        @default(0)
  lastQualifiedAt DateTime?
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  initiative      Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@unique([userId, initiativeId])
}

model Group {
  id           String            @id @default(cuid())
  initiativeId String
  ownerId      String
  name         String
  description  String?
  joinCode     String            @unique
  createdAt    DateTime          @default(now())
  initiative   Initiative        @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  owner        User              @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members      GroupMembership[]

  @@index([initiativeId])
}

model GroupMembership {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Report {
  id            String     @id @default(cuid())
  initiativeId  String
  requestedById String
  status        String     @default("QUEUED")
  format        String
  storageUrl    String?
  createdAt     DateTime   @default(now())
  completedAt   DateTime?
  initiative    Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@index([initiativeId, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
